#!/usr/bin/expect -f
set timeout 30

proc generate_secret {} {
  return [string trim [exec /opt/homebrew/bin/openssl rand -base64 48 2>@1]]
}

proc store_secret {account service secret_value} {
  log_user 0
  spawn -noecho /usr/bin/security add-generic-password -U \
    -a $account -s $service -w
  expect {
    -re {(?i)password.*:} {
      send -- "$secret_value\r"
      exp_continue
    }
    eof {}
    timeout { error "keychain_prompt_timeout" }
  }
  set child_status [wait]
  if {[lindex $child_status 3] != 0} {
    error "keychain_write_failed"
  }
}

set bootstrap_secret [generate_secret]
set runtime_secret [generate_secret]
while {$runtime_secret eq $bootstrap_secret} {
  set runtime_secret [generate_secret]
}

if {$argv eq {--self-test}} {
  if {[string length $bootstrap_secret] < 64 ||
      [string length $runtime_secret] < 64} {
    exit 1
  }
  puts "E5_CORE_SECRET_GENERATION_SELF_TEST_PASS"
  exit 0
}

if {[catch {
  store_secret "core-memory-staging-bootstrap" \
    "jp.apparetenkei.farmos-core-staging.core-memory-bootstrap" \
    $bootstrap_secret
  store_secret "core-memory-staging-readonly" \
    "jp.apparetenkei.farmos-core-staging.core-memory-readonly" \
    $runtime_secret
}]} {
  puts stderr "E5_CORE_KEYCHAIN_SECRET_MATERIALIZATION_FAILED"
  exit 1
}

puts "E5_CORE_KEYCHAIN_SECRET_MATERIALIZATION_COMPLETE"
