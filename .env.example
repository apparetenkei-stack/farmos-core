# Hermes Day65 local LLM smoke test
HERMES_LLM_PROVIDER=ollama
HERMES_OLLAMA_BASE_URL=http://127.0.0.1:11434
HERMES_OLLAMA_MODEL=qwen3.5:4b
HERMES_LLM_TIMEOUT_MS=30000
HERMES_LLM_SMOKE_TEST_ENABLED=false

# FarmOS Core local development example
# Copy this file to .env.local and edit values.

POSTGRES_DB=farmos_core_local
POSTGRES_USER=farmos_local_admin
POSTGRES_PASSWORD=change-me-local-password

REDIS_PASSWORD=change-me-redis-password

MINIO_ROOT_USER=farmos_minio_admin
MINIO_ROOT_PASSWORD=change-me-minio-password

QDRANT_API_KEY=change-me-qdrant-api-key

# Hermes Day69 API chat minimal boundary
HERMES_API_CHAT_MINIMAL_BOUNDARY_ENABLED=false
